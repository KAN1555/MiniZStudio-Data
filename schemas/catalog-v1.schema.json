{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MiniZStudio public data catalog v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "updatedAt",
    "layouts",
    "regulations",
    "vehicles",
    "settings",
    "lapRecords"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    },
    "layouts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "regulations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "vehicles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "settings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "lapRecords": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "id",
        "name",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^(layouts|regulations|vehicles|settings|lap-records)/[A-Za-z0-9_.-]+\\.json$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  }
}
