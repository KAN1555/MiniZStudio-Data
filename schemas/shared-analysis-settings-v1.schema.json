{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MiniZStudio shared defaults (never personal preferences)",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "parameters"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    }
  },
  "additionalProperties": false
}
